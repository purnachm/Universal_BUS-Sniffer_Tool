<Application x:Class="SniffOS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10161F" />
        <SolidColorBrush x:Key="PanelBackground" Color="#18212D" />
        <SolidColorBrush x:Key="PanelBorder" Color="#2E3C50" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F6FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9EADBE" />
        <SolidColorBrush x:Key="Accent" Color="#35C7A0" />
        <SolidColorBrush x:Key="Warning" Color="#F4B860" />
        <SolidColorBrush x:Key="Danger" Color="#F06A73" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#263447" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#596878" />
                    <Setter Property="Background" Value="#E8EDF2" />
                    <Setter Property="BorderBrush" Value="#C8D1DA" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#15202B" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#9AA8B5" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#15202B" />
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Padding" Value="6,4" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Background" Value="#287A68" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#15202B" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Application.Resources>
</Application>
